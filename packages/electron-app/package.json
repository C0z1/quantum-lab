{
  "name": "quantum-lab",
  "version": "1.2.0",
  "description": "Quantum Lab — visualizador 3D interactivo de algoritmos cuánticos (Grover, Teletransportación, Shor, Deutsch-Jozsa, Bernstein-Vazirani, QFT)",
  "author": "C0z1",
  "license": "MIT",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\""
  },
  "dependencies": {
    "msgpackr": "^1.12.1",
    "three": "^0.164.1",
    "zeromq": "^6.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^8.0.0",
    "electron": "^30.5.1",
    "electron-builder": "^24.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8"
  },
  "build": {
    "appId": "com.quantumlab.app",
    "productName": "Quantum Lab",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "engine-bin",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "QuantumLab-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Quantum Lab"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Science"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    }
  }
}
